[Unit]
Description=Sub2API passive admin probe log exporter
After=docker.service
Requires=docker.service

[Service]
Type=simple
User=ubuntu
Group=ubuntu
UMask=0077
ExecStart=/usr/bin/python3 /opt/sub2api/diagnostics/turn_state_log_export.py --runtime-dir /var/lib/sub2api-turnstate --config /opt/sub2api/diagnostics/config.json
Restart=on-failure
RestartSec=30
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
